{
	"name": "Nightfall",
	"globIgnorePaths": [
		"**/*.spec.lua"
	],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$path": "src/shared",
			"$ignoreUnknownInstances": true,
			"Packages": {
				"$path": "Packages"
			}
		},
		"ServerScriptService": {
			"$path": "src/server",
			"$ignoreUnknownInstances": true,
			"NetworkInterface": {
				"$path": "src/entry/NetworkInterface"
			}
		},
		"ReplicatedFirst": {
			"$ignoreUnknownInstances": true,
			"BOOTSTRAP": {
				"$path": "src/entry/BOOTSTRAP.client.lua"
			}
		},
		"StarterPlayer": {
			"$ignoreUnknownInstances": true,
			"StarterPlayerScripts": {
				"$ignoreUnknownInstances": true,
				"Setup": {
					"$path": "src/entry/Setup"
				}
			}
		}
	}
}
